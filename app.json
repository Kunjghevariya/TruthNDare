{
  "expo": {
    "name": "Truth N Dare",
    "slug": "truth-n-dare",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Colorful Modern Infinity Technology Free Logo.png",
    "scheme": "truthndare",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#081120"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Colorful Modern Infinity Technology Free Logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "appVariant": "production"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
